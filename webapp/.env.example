# ── Backend für den Chat-Flow (POST /api/chat) — PFLICHT ──────────────────
# Die Diagnose läuft ausschließlich über die OpenAI-Cloud (Orchestrator). Es gibt
# keine Demo-/Seed-Geräte. Ohne Key antwortet /api/chat mit HTTP 503
# (code: "no_backend") — kein Crash, aber auch kein Demo-Modus.
OPENAI_API_KEY=
# Modell für die Diagnose. Default: gpt-4o-mini.
# Es muss ein OpenAI-Chat-Modell sein, das die Chat-Completions-API mit
# response_format=json_object UND einem frei wählbaren temperature-Wert
# unterstützt (so ruft der Code es auf, s. repair/ai.py).
# Bewährte, Vision-fähige Optionen (von günstig → stärker):
#   gpt-4o-mini   – Default, günstig, schnell, kann Vision
#   gpt-4o        – stärker, kann Vision
#   gpt-4.1-nano  – sehr günstig
#   gpt-4.1-mini  – guter Kompromiss
#   gpt-4.1       – stärkstes 4.1, kann Vision
#   gpt-4-turbo   – ältere Generation, kann Vision
# ⚠ NICHT geeignet: Reasoning-/o-Modelle (o1, o3, o4-mini) — sie lehnen den
#   gesetzten temperature-Wert ab und nutzen max_completion_tokens; der Code
#   müsste dafür angepasst werden.
OPENAI_MODEL=gpt-4o-mini

# Modell für die Audio-Transkription (OpenAI Whisper, PROJ-27). Default: whisper-1.
# Mögliche Werte: whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe.
# ⚠ AKTUELL OHNE FUNKTION: Der Wert wird zwar vom Endpoint /api/transkription
#   ausgewertet, aber kein Frontend-Code ruft diesen Endpoint auf — die
#   Spracheingabe läuft im Browser über die Web-Speech-API (static/js/screens.js).
#   Greift erst, sobald das Frontend serverseitige Whisper-Transkription nutzt.
#WHISPER_MODEL=whisper-1

# Vision-Modell für die Bild-/Dokument-Auswertung (PROJ-31). Wird vom Code
# gelesen; ungesetzt gilt das Cloud-Diagnose-Modell (OPENAI_MODEL / gpt-4o-…,
# kann ebenfalls Vision). Auskommentiert lassen = Default nutzen; zum
# Übersteuern ein eigenes Vision-fähiges OpenAI-Modell eintragen.
# Vision-fähige Optionen: gpt-4o-mini, gpt-4o, gpt-4.1-mini, gpt-4.1, gpt-4-turbo.
#VISION_MODEL=gpt-4o

# Timeout in Sekunden für eine LLM-Antwort.
#LLM_TIMEOUT=180

# Max. Tool-Call-Runden pro Chat-Turn (Endlosschleifen-/Kostenschutz). Default 12.
#MAX_TOOL_ITERATIONS=12

# ── Kontext-Verdichtung & Token-Budget (PROJ-41) ──────────────────────────
# Pro Turn wird nicht mehr der gesamte Verlauf gesendet: ältere Turns werden zu
# einem kompakten Zustands-Digest verdichtet, geladene Rollen-Volltexte nach
# Gebrauch entladen; die jüngsten Turns bleiben wörtlich erhalten.
# Weiche Obergrenze (geschätzte Tokens) des gesendeten variablen Kontexts.
# Default 6000; gültig 500..1000000 (sonst Abbruch beim Start). Ein definierter
# Mindest-Kontext (Digest + jüngste Turns) bleibt auch bei kleinem Budget erhalten.
#KONTEXT_TOKEN_BUDGET=6000
# Anzahl jüngster Turns, die WÖRTLICH (unverdichtet) gesendet werden.
# Default 4; gültig 1..100 (sonst Abbruch beim Start).
#KONTEXT_WOERTLICH_TURNS=4

# ── Recherche-Online-Fallback (PROJ-16) ──────────────────────────────────
# SearXNG-Instanz für die optionale Online-Recherche. Leer/ungesetzt = nur
# kuratiert + KI-Fallback, keine Online-Suche.
#SEARXNG_URL=http://localhost:8080

# ── Anfrage-Protokoll / Betreiber-Debug-Log (PROJ-28) ─────────────────────
# Schreibt pro KI-/Fach-Anfrage eine Markdown-Datei nach webapp/protokolle/
# (gitignored, Rohdaten). Default „an". Auf 0 setzen für saubere Testläufe.
#PROTOKOLL_ENABLED=1

# ── Zentrales Logging (PROJ-29) ───────────────────────────────────────────
# Log-Level für Datei (webapp/logs/repair.log, täglich rotiert, 14 Tage) und
# Konsole. Erlaubt: DEBUG, INFO, WARNING, ERROR, CRITICAL. Ungültige Werte
# fallen automatisch auf DEBUG zurück (kein Crash). Default (ungesetzt): DEBUG.
# ⚠ Auf DEBUG landen Klartext-Nutzereingaben im Log — nur lokal/Dev nutzen.
# Für Produktion mindestens INFO setzen.
#LOG_LEVEL=DEBUG

# ── Flask ─────────────────────────────────────────────────────────────────
# Flask-Debug-Modus (1 = an, 0 = aus)
FLASK_DEBUG=1

# ── App-Bindung & Limits (PROJ-30) ────────────────────────────────────────
# Bind-Adresse und Port der App. Im Container z. B. HOST=0.0.0.0 setzen.
# Defaults: 127.0.0.1 / 5000. PORT muss 1..65535 sein, sonst Abbruch beim Start.
#HOST=127.0.0.1
#PORT=5000

# Maximale Mediengröße (Foto/Video/Audio) in Bytes. Default 10485760 (10 MB).
# Muss > 0 sein, sonst Abbruch beim Start.
#MAX_UPLOAD_BYTES=10485760

# ── Vision-Diagnose (PROJ-31) ─────────────────────────────────────────────
# Obergrenze Medien pro Diagnose-Anfrage. Default 6; gültig 1..100 (sonst
# Abbruch beim Start). Bei Überschreitung im UI: Hinweis statt Fehler.
#MAX_MEDIEN_PRO_ANFRAGE=6
# Max. ausgewertete Seiten je beigefügtem PDF. Default 5; gültig 1..50.
# Überzählige Seiten werden mit sichtbarem Hinweis gekürzt.
#MAX_PDF_SEITEN=5

# ── Service-Point-Übergabe-Report PDF (PROJ-44) ───────────────────────────
# Serverseitige PDF-Erzeugung via PyMuPDF (fitz.Story). Default „an" (1).
# Auf 0 setzen, um den PDF-Download zu deaktivieren — der Markdown-/Text-Download
# bleibt dann als Ersatzweg immer verfügbar (ehrliche Degradation D3).
# Fehlt PyMuPDF, wird PDF automatisch deaktiviert (unabhängig von diesem Wert).
#REPORT_PDF_ENABLED=1

# ── Feedback-Button (PROJ-46) ─────────────────────────────────────────────
# Feedback-Funktion an/aus. Default an. Auf 0 setzen blendet den Button aus;
# der Endpunkt /api/feedback antwortet dann sauber ablehnend (403, code disabled).
#FEEDBACK_ENABLED=1
# Maximale Feedback-Textlänge in Bytes (UTF-8). Default 4000; 1..10000000 (sonst Fail-fast).
#MAX_FEEDBACK_BYTES=4000

# ── Prompt-Caching steuern (PROJ-48) ──────────────────────────────────────
# OpenAI cached identische Prompt-Präfixe automatisch. Optionaler statischer
# prompt_cache_key je Sprache verbessert das Cache-Routing. Default an.
#PROMPT_CACHE_KEY_ENABLED=1
# Präfix des prompt_cache_key (Schlüssel = "<präfix>-<sprache>", z. B. repair-de). Default repair.
#PROMPT_CACHE_KEY_PREFIX=repair
